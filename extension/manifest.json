{
  "manifest_version": 3,
  "name": "Spectra",
  "version": "0.1.0",
  "description": "Reads selected text using the Web Speech API.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tts",
    "scripting",
    "notifications",
    "commands"
  ],

  "host_permissions": ["<all_urls>","https://*.firebaseio.com/*",
    "https://firestore.googleapis.com/*", "https://www.gstatic.com/*",
  "https://spectra-f0c6b.firebaseapp.com/*"],

"background": {
  "service_worker": "background.js",
  "type": "module"
}
,

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
       
        "styles.css",
        "popup.css",
        "popup.css",
      "feedback/feedback.html",
      "feedback/feedback.js",
      "feedback/feedback.css",
      "feedback/firebase.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "read-page": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Command+Shift+Y"
      },
      "description": "Read the current page"
    },
    "summarize-page": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Summarize the current page"
    },
    "stop-tts": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Stop TTS"
    },
    "pause-resume-tts": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+O"
      },
      "description": "Pause/Resume TTS"
    }
  }
}